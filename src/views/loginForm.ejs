<%- contentFor('title') %>Вхід - LPMonitor
<%- contentFor('head') %>
<link rel="preconnect" href="https://challenges.cloudflare.com">
<script
	src="https://challenges.cloudflare.com/turnstile/v0/api.js"
	async
	defer
></script>
<%- contentFor('body') %>
<h1>Вхід в акаунт LPMonitor</h1>
<form id="authForm" method="post">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<input type="email" name="email" id="emailInput" <% if(locals.email) { %>value="<%= locals.email %>"<% } %> placeholder="student@lpnu.ua" required minlength="8" pattern="[a-zA-Z0-9.]+@lpnu\.ua" title="Введіть адресу вашої коропоративної пошти lpnu.ua" />
	<input type="password" name="password" id="passwordInput" placeholder="Пароль" title="Введіть пароль від вашого акаунту" />
	<div class="cf-turnstile" data-sitekey="0x4AAAAAACVVH3qwJ7RFelkG"></div>
	<input disabled type="submit" id="submitButton" value="Ввійти" />
</form>
<a href="/reset-password">Забули пароль?</a> <a href="/register">Ще не зареєстровані?</a>
<script src="/js/email-validation.js"></script>
