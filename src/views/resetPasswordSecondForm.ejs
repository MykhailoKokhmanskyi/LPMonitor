<%- contentFor('title') %>Скидання пароля LPMonitor
<%- contentFor('body') %>
<h1>Скидання пароля LPMonitor</h1>
<form id="resetForm" method="POST">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<input type="password" id="passwordInput" name="password" placeholder="Введіть пароль"/>
	<input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="Введіть ваш пароль знову"/>
	<p><b>Пароль повинен містити:</b></p>
	<p>Мінімум 8 символів</p>
	<p>Малі букви</p>
	<p>Великі букви</p>
	<p>Мінімум 1 цифру</p>
	<input disabled type="submit" id="submitButton" value="Скинути пароль" />
</form>
<script src="/js/reset-password-validation.js"></script>
