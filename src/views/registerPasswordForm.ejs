<%- contentFor('title') %>Реєстрація - LPMonitor
<%- contentFor('head') %>
<link rel="preconnect" href="https://challenges.cloudflare.com">
<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer
></script>
<%- contentFor('body') %>
<h1>Реєстрація акаунту LPMonitor</h1> 
<form id="registrationForm" method="post">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
	<input type="email" name="email" value="<%= locals.email %>" style="display: none;"/> 
	<input type="password" id="passwordInput" name="password" placeholder="Введіть пароль"/>
	<input type="password" id="passwordConfirm" name="passwordConfirm" placeholder="Введіть ваш пароль знову"/>
	<p><b>Пароль повинен містити:</b></p>
	<p>Мінімум 8 символів</p>
	<p>Малі букви</p>
	<p>Великі букви</p>
	<p>Мінімум 1 цифру</p>
	<div class="cf-turnstile" data-sitekey="0x4AAAAAACVVH3qwJ7RFelkG"></div>
	<input disabled type="submit" id="submitButton" value="Зареєструватись" />
</form>
<script src="/js/password-validation.js"></script>
