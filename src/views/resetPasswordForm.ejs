<%- contentFor('title') %>Скидання пароля
<%- contentFor('head') %>
<link rel="preconnect" href="https://challenges.cloudflare.com">
<script
	src="https://challenges.cloudflare.com/turnstile/v0/api.js"
	async
	defer
></script>
<%- contentFor('body') %>
<h1>Скидання пароля LPMonitor</h1>
<form id="passwordResetForm" method="POST">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>">
	<input type="email" name="email" id="emailInput" placeholder="student@lpnu.ua" required minlength="8" title="Введіть адресу вашої електронної пошти lpnu.ua" />
	<div class="cf-turnstile" data-sitekey="0x4AAAAAACVVH3qwJ7RFelkG"></div>
	<input type="submit" id="submitButton" value="Скинути пароль" />
</form>
